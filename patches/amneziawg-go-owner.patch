+func claimInterfaceOwnership(interfaceName string) error {
+	owner := os.Getenv("AMN_QUICK_OWNER")
+	helper := os.Getenv("AMN_LINK_HELPER")
+	if owner == "" && helper == "" {
+		return nil
+	}
+	if owner == "" || helper == "" {
+		return fmt.Errorf("interface ownership environment is incomplete")
+	}
+	return exec.Command(helper, "claim", interfaceName, owner).Run()
+}
